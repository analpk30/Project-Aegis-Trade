
FROM node:20-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.ts tsconfig.json ./
COPY src ./src
COPY assets ./assets
COPY server.ts cache.ts ./

# Must produce both: dist/ (frontend assets) AND dist/server.cjs (bundled gateway)
RUN npm run build


FROM node:20-bookworm-slim AS runner
WORKDIR /app


RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=3000
ENV PYTHON_PORT=5000
ENV VIRTUAL_ENV=/app/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Node production deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Python deps — installed in an isolated venv, cached as its own layer
COPY python_backend/requirements.txt ./python_backend/requirements.txt
RUN python3 -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir -r python_backend/requirements.txt

# App code
COPY --from=builder /app/dist ./dist
COPY python_backend ./python_backend

# Frontend gateway (React SPA + API proxy)
EXPOSE 3000
# Python AI backend (direct API access)
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://127.0.0.1:3000/api/health', (r) => { r.resume(); process.exit(r.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1))"

# Single-file entrypoint — written inline so nothing external needs to be COPY'd in.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -e' \
    'PYTHON_PORT="${PYTHON_PORT:-5000}"' \
    'PORT="${PORT:-3000}"' \
    'export SKIP_PYTHON_SPAWN=true' \
    '' \
    'echo "[Docker] Starting Python AI Backend on port ${PYTHON_PORT}..."' \
    'python3 python_backend/app.py "${PYTHON_PORT}" &' \
    'PYTHON_PID=$!' \
    '' \
    'NODE_PID=""' \
    'cleanup() {' \
    '  echo "[Docker] Shutting down services..."' \
    '  [ -n "$NODE_PID" ] && kill "$NODE_PID" 2>/dev/null || true' \
    '  kill "$PYTHON_PID" 2>/dev/null || true' \
    '  wait 2>/dev/null || true' \
    '}' \
    'trap cleanup INT TERM' \
    '' \
    'echo "[Docker] Waiting for Python backend to become healthy..."' \
    'attempt=0' \
    'until node -e "' \
    '  require(\x27http\x27).get(\x27http://127.0.0.1:${PYTHON_PORT}/api/health\x27, (r) => {' \
    '    r.resume();' \
    '    process.exit(r.statusCode === 200 ? 0 : 1);' \
    '  }).on(\x27error\x27, () => process.exit(1));" 2>/dev/null; do' \
    '  attempt=$((attempt + 1))' \
    '  if [ "$attempt" -ge 30 ]; then' \
    '    echo "[Docker] ERROR: Python backend failed to start within 30s"' \
    '    cleanup' \
    '    exit 1' \
    '  fi' \
    '  if ! kill -0 "$PYTHON_PID" 2>/dev/null; then' \
    '    echo "[Docker] ERROR: Python backend process exited unexpectedly"' \
    '    exit 1' \
    '  fi' \
    '  sleep 1' \
    'done' \
    'echo "[Docker] Python backend is ready."' \
    '' \
    'echo "[Docker] Starting Node frontend gateway on port ${PORT}..."' \
    'node dist/server.cjs &' \
    'NODE_PID=$!' \
    'wait "$NODE_PID"' \
    'EXIT_CODE=$?' \
    'cleanup' \
    'exit "$EXIT_CODE"' \
    > /app/docker-entrypoint.sh \
    && chmod +x /app/docker-entrypoint.sh

ENTRYPOINT ["./docker-entrypoint.sh"]