
FROM python:3.11-slim
WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHON_PORT=5000

COPY python_backend/requirements.txt ./python_backend/requirements.txt
RUN pip install --no-cache-dir -r python_backend/requirements.txt

COPY python_backend ./python_backend

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:5000/api/health').getcode()==200 else 1)"

CMD ["sh", "-c", "python3 python_backend/app.py ${PYTHON_PORT:-5000}"]